# ===== 存储层（都留空也能跑，会自动降级）=====
# 留空 -> 内存向量库（仅验证链路）；填写 -> 真实 pgvector
DATABASE_URL=
# 留空 -> fakeredis 兜底；填写 -> 真实 Redis
REDIS_URL=

# ===== 模型 =====
# st = 真实句向量；hash = 离线哈希兜底（指标不真实，仅跑通流程）
EMBED_BACKEND=st
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 重排模型，留空表示不重排
RERANK_MODEL=BAAI/bge-reranker-base

# ===== 生成层（/ask）=====
# 走 OpenAI 兼容接口，换厂商只要改这三个
MODEL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 留空则 /ask 退化成纯检索，不会报错
MODEL_API_KEY=
MODEL_NAME=qwen-plus
# 送进提示词的每段正文最长字数
PASSAGE_MAX_CHARS=600

# ===== 数据与评测 =====
# data_law = 本地法律语料；data = 内置 20 段示例语料
DATA_MODULE=data_law
TOPK=5
# 评测问句条数（重排较慢时可调小，正式评测建议 1000）
EVAL_MAX=150

# ===== 审计日志 =====
# 每次请求落一行 JSONL，含 query 原文、命中段落 id、答案耗时与 token，
# 用于事后回溯。设 0 关掉。日志里有真实问答内容，已在 .gitignore 里排除
AUDIT_ENABLED=1
# 留空则写在项目根目录 audit.jsonl
AUDIT_LOG_PATH=

# ===== 输入约束（防止畸形请求拖垮服务）=====
# query 超出这个长度直接 422
MAX_QUERY_CHARS=1000
# topk 的上限，同时也必须 ≥ 1
MAX_TOPK=20

# ===== HuggingFace（Windows 必看）=====
# Windows 默认无 symlink 权限，HF 缓存会退化成 0 字节文件，务必开启
HF_HUB_DISABLE_SYMLINKS=1
# 模型已下载到本地时开启，避免联网校验失败后静默降级
HF_HUB_OFFLINE=1
# 模型/缓存落地目录，例如 E:\Huggingface-Modles
HF_HOME=
